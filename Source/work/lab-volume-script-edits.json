[
  [
    "for(let r=0;r<=8;r++)for(let g=0;g<=8;g++)for(let b=0;b<=8;b++){\n const hex='#'+[r,g,b].map(n=>Math.round(n*255/8)",
    "for(let r=0;r<=16;r++)for(let g=0;g<=16;g++)for(let b=0;b<=16;b++){if(![r,g,b].some(n=>n%16==0)&&[r,g,b].some(n=>n%2))continue;\n const hex='#'+[r,g,b].map(n=>Math.round(n*255/16)"
  ],
