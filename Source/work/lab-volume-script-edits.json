    "cx=\"${p.x}\" cy=\"${p.y}\" r=\"${p.slice?3.2:2}\" fill=\"${p.hex}\" fill-opacity=\"${p.slice?1:.17}\"",
    "cx=\"${p.x.toFixed(1)}\" cy=\"${p.y.toFixed(1)}\" r=\"${p.slice?3.2:1.7}\" fill=\"${p.hex}\" fill-opacity=\"${p.slice?1:.14}\""
  ],
  [
    "for(let a=-104;a<=104;a+=8)for(let b=-104;b<=104;b+=8)",
